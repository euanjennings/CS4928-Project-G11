# Order matters: later lines override earlier ones.

# Everything we write ourselves: normalise to LF
* text=auto eol=lf
*.bat text eol=crlf
*.png binary
*.pdf binary
*.xlsx binary

# Keep the upstream import byte-for-byte identical (it mixes CRLF and LF files).
# Without this, Git can rewrite line endings and pollute the audit diff.
upstream/** -text

# Preserve checksummed Event A evidence on every platform.
extension/event_a/** -text
results/event_a/** -text

# Preserve checksummed scientific inputs and caches byte-for-byte.
extension/apktool/*.csv -text
extension/apktool/publication/inputs/*.csv -text
extension/apktool/results/apktool_similarity_cache.json -text
extension/apktool/results_v3/apktool_similarity_cache.json -text
extension/apktool/results_v4/apktool_similarity_cache.json -text
extension/apktool/publication/cleanup.patch -text
