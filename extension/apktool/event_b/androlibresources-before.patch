+    public String getFrameworkCacheSummary() throws AndrolibException {
+        File dir = getFrameworkDirectory();
+        File[] files = dir.listFiles();
+
+        if (files == null) {
+            throw new AndrolibException("Cannot list framework directory: " + dir);
+        }
+
+        int apkCount = 0;
+        long totalBytes = 0;
+
+        for (File file : files) {
+            if (file.isFile() && file.getName().endsWith(".apk")) {
+                apkCount++;
